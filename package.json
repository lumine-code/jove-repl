{
  "name": "hydrogen",
  "author": "lumine-code",
  "description": "Run code interactively with Jupyter kernels",
  "repository": "https://github.com/lumine-code/hydrogen",
  "bugs": {
    "url": "https://github.com/lumine-code/hydrogen/issues"
  },
  "homepage": "https://github.com/lumine-code/hydrogen#readme",
  "keywords": [
    "execute",
    "run",
    "jupyter",
    "ipython",
    "julia",
    "python",
    "torch",
    "ijulia",
    "irkernel",
    "itorch",
    "plot",
    "image"
  ],
  "version": "5.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../hydrogen/spec",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "hydrogen-adapter:item-used"
  ],
  "activationCommands": {
    "atom-text-editor:not([mini])": [
      "hydrogen:run",
      "hydrogen:run-all",
      "hydrogen:run-all-above",
      "hydrogen:run-and-move-down",
      "hydrogen:run-cell",
      "hydrogen:run-cell-and-move-down",
      "hydrogen:toggle-watches",
      "hydrogen:toggle-output-area",
      "hydrogen:start-local-kernel",
      "hydrogen:connect-to-remote-kernel",
      "hydrogen:connect-to-existing-kernel",
      "hydrogen:add-watch",
      "hydrogen:remove-watch",
      "hydrogen:update-kernels",
      "hydrogen:interrupt-kernel",
      "hydrogen:restart-kernel",
      "hydrogen:shutdown-kernel",
      "hydrogen:export-notebook",
      "hydrogen:fold-current-cell",
      "hydrogen:fold-all-but-current-cell",
      "hydrogen:clear-results",
      "hydrogen:clear-and-restart",
      "hydrogen:clear-and-center",
      "hydrogen:recalculate-all",
      "hydrogen:recalculate-all-above",
      "hydrogen:run-all-inline",
      "hydrogen:recalculate-all-inline",
      "hydrogen:run-all-above-inline",
      "hydrogen:run-all-below-inline",
      "hydrogen:recalculate-all-above-inline",
      "hydrogen:go-to-next-cell",
      "hydrogen:go-to-previous-cell",
      "hydrogen:select-cell",
      "hydrogen:select-previous-cell",
      "hydrogen:select-next-cell",
      "hydrogen:move-cell-up",
      "hydrogen:move-cell-down",
      "hydrogen:open-jupyter-console",
      "hydrogen:spawn-jupyter-console",
      "hydrogen:copy-jupyter-console-command"
    ],
    "atom-workspace": [
      "hydrogen:import-notebook",
      "hydrogen:open-data-explorer",
      "hydrogen:debug-toggle",
      "hydrogen:toggle-kernel-monitor-focus",
      "hydrogen:toggle-exec-panel",
      "hydrogen:toggle-variable-explorer",
      "hydrogen:hot-reload-package",
      "hydrogen:open-examples",
      "hydrogen:open-gateways",
      "hydrogen:shutdown-all-kernels",
      "hydrogen:toggle-inspector-focus",
      "hydrogen:inspect-under-cursor"
    ]
  },
  "consumedServices": {
    "autocomplete.watchEditor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "hydrogen-adapter": {
      "versions": {
        "1.0.0": "consumeHydrogenAdapter"
      }
    },
    "claude-chat": {
      "versions": {
        "^1.0.0": "consumeClaudeChat"
      }
    },
    "image-editor": {
      "versions": {
        "1.0.0": "consumeImageEditor"
      }
    },
    "terminal": {
      "versions": {
        "2.0.0": "consumeTerminal"
      }
    },
    "terminal-spawn": {
      "versions": {
        "^1.0.0": "consumeTerminalSpawn"
      }
    },
    "scroll-keeper": {
      "versions": {
        "^1.0.0": "consumeScrollKeeper"
      }
    }
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "4.0.0": "provideAutocompleteResults"
      }
    },
    "hydrogen.provider": {
      "versions": {
        "1.3.0": "provideHydrogen"
      }
    },
    "hydrogen.breakpoints": {
      "versions": {
        "0.0.1": "provideBreakpoints"
      }
    },
    "search-adapter": {
      "versions": {
        "1.0.0": "provideSearchAdapter"
      }
    }
  },
  "dependencies": {
    "@asiloisad/select-list": "^1.6.0",
    "@jupyterlab/services": "^7.5.0",
    "@mathjax/src": "^4.0.0",
    "@nteract/any-vega": "^1.0.1",
    "@nteract/commutable": "^7.5.1",
    "anser": "^2.3.3",
    "kernelspecs": "^2.0.1",
    "lodash": "^4.17.21",
    "mobx": "^6.13.5",
    "mobx-react": "^9.2.0",
    "natural-compare-lite": "^1.4.0",
    "plotly.js-dist": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spawnteract": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "xmlhttprequest": "^1.8.0",
    "zeromq": "^6.5.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.9.5"
  }
}
