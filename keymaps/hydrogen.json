{
  "atom-workspace": {
    "alt-h i": "hydrogen:toggle-inspector-focus",
    "alt-h d": "hydrogen:open-data-explorer",
    "alt-h k": "hydrogen:toggle-kernel-monitor-focus",
    "alt-h v": "hydrogen:toggle-variable-explorer",
    "alt-h o": "hydrogen:toggle-output-area",
    "alt-h w": "hydrogen:toggle-watches",
    "alt-h e": "hydrogen:toggle-exec-panel"
  },

  "atom-workspace atom-text-editor:not([mini]):not(atom-dock atom-text-editor)": {
    "cmdorctrl-enter": "hydrogen:run",
    "shift-enter": "hydrogen:run-and-move-down",
    "alt-enter": "hydrogen:run-cell",
    "shift-alt-enter": "hydrogen:run-cell-and-move-down",
    "cmdorctrl-shift-enter": "hydrogen:run-all",
    "ctrl-shift-backspace": "hydrogen:clear-results",
    "cmdorctrl-alt-backspace": "hydrogen:clear-results"
  },

  "atom-workspace .hydrogen.kernel-picker atom-text-editor[mini]": {
    "ctrl-enter": "select-list:kernel",
    "f5": "hydrogen:update-kernels"
  },

  "atom-workspace atom-text-editor.data-explorer-expression:not([mini])": {
    "enter": "core:confirm",
    "shift-enter": "editor:newline",
    "escape": "core:cancel",
    "tab": "hydrogen:data-explorer-focus-toolbar",
    "shift-tab": "hydrogen:data-explorer-focus-body"
  },

  "atom-workspace .data-explorer-toolbar-row": {
    "left": "hydrogen:data-explorer-toolbar-left",
    "right": "hydrogen:data-explorer-toolbar-right",
    "enter": "hydrogen:data-explorer-toolbar-confirm",
    "tab": "hydrogen:data-explorer-focus-body",
    "shift-tab": "hydrogen:data-explorer-focus-expression"
  },

  "atom-workspace atom-text-editor.inspector-expression:not([mini])": {
    "enter": "core:confirm",
    "shift-enter": "editor:newline",
    "escape": "core:cancel",
    "tab": "hydrogen:inspector-focus-body",
    "shift-tab": "hydrogen:inspector-focus-body"
  },

  "atom-workspace .data-explorer-body": {
    "tab": "hydrogen:data-explorer-focus-expression",
    "shift-tab": "hydrogen:data-explorer-focus-toolbar"
  },

  "atom-workspace .data-explorer-canvas-wrap": {
    "enter": "core:confirm",
    "backspace": "hydrogen:data-explorer-drill-up",
    "up": "core:move-up",
    "down": "core:move-down",
    "left": "core:move-left",
    "right": "core:move-right",
    "shift-up": "core:select-up",
    "shift-down": "core:select-down",
    "shift-left": "core:select-left",
    "shift-right": "core:select-right",
    "pageup": "hydrogen:data-grid-page-up",
    "pagedown": "hydrogen:data-grid-page-down",
    "shift-pageup": "hydrogen:data-grid-select-page-up",
    "shift-pagedown": "hydrogen:data-grid-select-page-down",
    "home": "hydrogen:data-grid-move-to-row-start",
    "end": "hydrogen:data-grid-move-to-row-end",
    "shift-home": "hydrogen:data-grid-select-to-row-start",
    "shift-end": "hydrogen:data-grid-select-to-row-end",
    "cmdorctrl-home": "core:move-to-top",
    "cmdorctrl-end": "core:move-to-bottom",
    "cmdorctrl-shift-home": "core:select-to-top",
    "cmdorctrl-shift-end": "core:select-to-bottom",
    "shift-space": "hydrogen:data-grid-select-row",
    "ctrl-space": "hydrogen:data-grid-select-column"
  },

  "atom-workspace .hydrogen.inspector .inspector-body": {
    "up": "hydrogen:inspector-scroll-up",
    "down": "hydrogen:inspector-scroll-down",
    "tab": "hydrogen:inspector-focus-expression",
    "shift-tab": "hydrogen:inspector-focus-expression"
  },

  "atom-workspace atom-text-editor.watch-input:not([mini])": {
    "enter": "core:confirm",
    "shift-enter": "editor:newline"
  },

  "atom-workspace .kernel-monitor-wrapper": {
    "up": "hydrogen:kernel-monitor-up",
    "down": "hydrogen:kernel-monitor-down",
    "enter": "hydrogen:kernel-monitor-open",
    "i": "hydrogen:kernel-monitor-interrupt",
    "r": "hydrogen:kernel-monitor-restart",
    "s": "hydrogen:kernel-monitor-shutdown"
  }
}
